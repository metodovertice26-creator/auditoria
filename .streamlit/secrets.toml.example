# Copie este modelo para as configurações de "Secrets" no Streamlit Community Cloud
# (App settings -> Secrets). Nunca versione o arquivo .streamlit/secrets.toml no Git.

# Senha de acesso à aplicação (opcional localmente; recomendado na nuvem)
APP_PASSWORD = "troque-por-uma-senha-forte"

# Isola o DuckDB por sessão de navegador (recomendado no Streamlit Cloud para evitar conflitos)
ISOLATE_SESSION_DB = true

# Credenciais opcionais da API REST do ERP Omie
OMIE_APP_KEY = ""
OMIE_APP_SECRET = ""
